+
+/// Native BG1: packed 48x32 tile picture in two screen blocks, scrolled to a
+/// 256x192 viewport and rotated counter-clockwise to the portrait display.
+pub fn bg_window(sc: &Nscr, ch: &Ncgr, pal: Option<&Nclr>, hofs: i32, vofs: i32) -> Image {
+    let ents: Vec<u32> = sc.raw.chunks_exact(2).map(|c| u16::from_le_bytes([c[0], c[1]]) as u32).collect();
+    let mut out = Image::new(192, 256);
+    for y in 0..192usize { for x in 0..256usize {
+        let sx = (x as i32 + hofs).rem_euclid(512) as usize;
+        let sy = (y as i32 + vofs).rem_euclid(256) as usize;
+        let (tx, ty) = (sx/8, sy/8);
+        if tx >= 48 { continue; }
+        let i = if tx < 32 { ty*32+tx } else { 1024+ty*16+tx-32 };
+        let Some(&e) = ents.get(i) else { continue };
+        let Some(tile) = ch.tile((e & 0x3ff) as usize) else { continue };
+        let px = if e & 0x400 != 0 { 7-sx%8 } else { sx%8 };
+        let py = if e & 0x800 != 0 { 7-sy%8 } else { sy%8 };
+        let key = if ch.bpp == 4 { e >> 12 } else { 0 };
+        out.put(y as i64, (255-x) as i64, pal_color(pal, ch.bpp, key, tile[py*8+px]));
+    } }
+    out
+}
